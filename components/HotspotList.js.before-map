"use client";
import { useCallback, useEffect, useState } from "react";
import { computeHotspots, reporterOf } from "@/lib/hotspots";

const COLORS = { red: "#ef4444", orange: "#f59e0b", yellow: "#eab308" };
const TREND = { worsening: "Getting worse", improving: "Improving", steady: "Steady" };

const card = {
  border: "1px solid rgba(255,255,255,0.14)",
  borderRadius: 16,
  padding: 16,
  marginBottom: 12,
};

export default function HotspotList() {
  const [hotspots, setHotspots] = useState([]);
  const [reporterKnown, setReporterKnown] = useState(true);
  const [state, setState] = useState("loading");

  const load = useCallback(async () => {
    try {
      const res = await fetch("/api/reports", { cache: "no-store" });
      if (res.status === 401 || res.status === 403) {
        setState("signin");
        return;
      }
      if (!res.ok) {
        setState("error");
        return;
      }
      const reports = await res.json();
      setReporterKnown(reports.some((r) => reporterOf(r) != null));
      setHotspots(computeHotspots(reports));
      setState("ready");
    } catch {
      setState("error");
    }
  }, []);

  useEffect(() => {
    load();
    const t = setInterval(load, 10000);
    return () => clearInterval(t);
  }, [load]);

  return (
    <section>
      <p style={{ margin: "0 0 12px" }}>
        <a className="link" href="/dashboard">Back to dashboard</a>
      </p>
      <h1 style={{ margin: "0 0 4px" }}>Most affected areas</h1>
      <p className="muted" style={{ marginTop: 0 }}>
        Reviewed reports only, grouped on a 500 m grid. Serious and recent reports count
        more, and several reports from one person count as one. Poor GPS fixes are left out.
      </p>

      {!reporterKnown && state === "ready" && (
        <p className="note" role="note">
          Reports do not carry a reporter identity yet, so repeat reports from one person
          cannot be told apart.
        </p>
      )}
      {state === "loading" && <p className="muted">Loading...</p>}
      {state === "signin" && (
        <p className="note">
          Please <a className="link" href="/login?next=/hotspots">sign in</a> to see hotspots.
        </p>
      )}
      {state === "error" && <p className="note" role="alert">Could not load reports. Try again.</p>}
      {state === "ready" && hotspots.length === 0 && (
        <p className="muted">No hotspots yet. Areas appear here once reports have been reviewed.</p>
      )}

      {hotspots.map((h) => (
        <div key={h.rank} style={{ ...card, borderLeft: "6px solid " + COLORS[h.level] }}>
          <div style={{ display: "flex", justifyContent: "space-between", gap: 12, flexWrap: "wrap" }}>
            <strong style={{ fontSize: 18 }}>
              #{h.rank} - {h.level.toUpperCase()} - score {h.score}
            </strong>
            <span className="muted">{TREND[h.trend]}</span>
          </div>
          <p style={{ margin: "8px 0" }}>
            {h.reportCount} {h.reportCount === 1 ? "report" : "reports"}
            {h.reporterCount != null ? " from " + h.reporterCount + (h.reporterCount === 1 ? " reporter" : " reporters") : ""}
            {" - mostly " + h.topType.toLowerCase()}
          </p>
          {h.singleSource && (
            <p className="note" style={{ margin: "0 0 8px" }}>
              Single reporter: capped at yellow until someone else reports this area.
            </p>
          )}
          <p className="muted" style={{ margin: "0 0 8px" }}>
            {h.lat.toFixed(4)}, {h.lng.toFixed(4)} - last report {new Date(h.lastReportAt).toLocaleDateString()}
          </p>
          <p className="muted" style={{ margin: "0 0 8px", fontSize: 14 }}>{h.ids.join(", ")}</p>
          <a
            className="link"
            target="_blank"
            rel="noopener noreferrer"
            href={`https://www.openstreetmap.org/?mlat=${h.lat}&mlon=${h.lng}#map=17/${h.lat}/${h.lng}`}
          >
            View on map
          </a>
        </div>
      ))}
    </section>
  );
}
